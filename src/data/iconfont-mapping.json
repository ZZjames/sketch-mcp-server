  "compoundIcons": {
    "description": "复合词强映射：节点名同时命中两个语义关键词时直接映射到 antd 复合图标，避免被通用词（如『新增』→PlusOutlined）吞掉真实语义。triggers 中两组关键词均命中即生效。",
    "rules": [
      { "antdIcon": "FolderAddOutlined", "triggers": [["文件夹", "目录", "folder"], ["新增", "添加", "add", "plus", "新建", "create"]], "rationale": "实战教训：『编组11备份』在 LeftTree 标题旁，原本应匹配 FolderAddOutlined，但被『新增』关键词吞噬为 PlusOutlined" },
      { "antdIcon": "FileAddOutlined", "triggers": [["文件", "文档", "file"], ["新增", "添加", "add", "plus", "新建", "create"]] },
      { "antdIcon": "UserAddOutlined", "triggers": [["用户", "人员", "user"], ["新增", "添加", "add", "plus", "新建", "create"]] },
      { "antdIcon": "TeamOutlined", "triggers": [["角色", "团队", "team", "role"], ["管理", "manage", "新增", "add"]] },
      { "antdIcon": "FolderOpenOutlined", "triggers": [["文件夹", "目录", "folder"], ["打开", "open", "展开", "expand"]] },
      { "antdIcon": "FolderOutlined", "triggers": [["文件夹", "目录", "folder"]], "rationale": "单一文件夹（无动作词），降级为通用 FolderOutlined" },
      { "antdIcon": "EditOutlined", "triggers": [["编辑", "修改", "edit"], ["笔", "pen", "pencil"]] },
      { "antdIcon": "SettingOutlined", "triggers": [["设置", "配置", "setting"], ["齿轮", "gear"]] }
    ]
